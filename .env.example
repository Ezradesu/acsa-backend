# Aplikasi
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5500

# PostgreSQL Supabase
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Login
JWT_SECRET=GANTI_DENGAN_RANDOM_SECRET_PANJANG

# Supabase Storage
SUPABASE_URL=https://PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=GANTI_DENGAN_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=GANTI_DENGAN_NAMA_BUCKET

# Midtrans
MIDTRANS_SERVER_KEY=GANTI_DENGAN_SERVER_KEY
MIDTRANS_CLIENT_KEY=GANTI_DENGAN_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=false

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=GANTI_DENGAN_AKUN_SMTP
SMTP_PASS=GANTI_DENGAN_PASSWORD_SMTP
SMTP_FROM="ACSA <noreply@example.com>"

# Redis
REDIS_URL=redis://redis:6379
CACHE_PREFIX=acsa
CACHE_TTL_SECONDS=300

# Elasticsearch
ELASTICSEARCH_NODE=http://elasticsearch:9200
ELASTICSEARCH_PRODUCT_INDEX=acsa-products
